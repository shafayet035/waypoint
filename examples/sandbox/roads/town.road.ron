// A small town: a 4-lane avenue (west–east) with sidewalks, a crossroads at
// "centre", a loop to the north-east (straight, arc and curve), and a curved
// link from "south" back to the avenue's west end. Right-hand traffic.
// Traffic lights at the centre. Bus stops form route 1, a loop round town
// (avenue east, River Bend, Park Lane, Mill Road, avenue west, Old Quarry
// Road, Market Street).
(
  name: "town",
  drive_side: Right,
  nodes: [
    (id: "west", position: (-150.0, 0.0)),
    (id: "centre", position: (0.0, 0.0), control: Signals((green_s: 20.0))),
    (id: "east", position: (150.0, 0.0)),
    (id: "north", position: (0.0, 120.0)),
    (id: "northeast", position: (150.0, 120.0)),
    (id: "south", position: (0.0, -120.0)),
  ],
  roads: [
    (id: "avenue_west", name: Some("Station Avenue"), from: "west", to: "centre",
     lanes_forward: 2, lanes_backward: 2, sidewalk_m: 3.0),
    (id: "avenue_east", name: Some("Station Avenue"), from: "centre", to: "east",
     lanes_forward: 2, lanes_backward: 2, sidewalk_m: 3.0),
    (id: "north_road", name: Some("Mill Road"), from: "centre", to: "north", sidewalk_m: 2.0),
    (id: "top_road", name: Some("Park Lane"), from: "north", to: "northeast",
     shape: Arc(radius_m: 110.0), speed_limit_kmh: 40.0),
    (id: "east_curve", name: Some("River Bend"), from: "northeast", to: "east",
     shape: Curve(through: [(195.0, 60.0)]), lanes_forward: 2, lanes_backward: 2, speed_limit_kmh: 40.0),
    (id: "south_road", name: Some("Market Street"), from: "centre", to: "south", sidewalk_m: 2.0),
    (id: "southwest_link", name: Some("Old Quarry Road"), from: "south", to: "west",
     shape: Curve(through: [(-105.0, -95.0)]), lanes_forward: 2, lanes_backward: 2, speed_limit_kmh: 40.0),
  ],
  stops: [
    (id: "station", name: "Station", road: "avenue_east", forward: true, at_m: 90.0),
    (id: "riverside", name: "Riverside", road: "east_curve", forward: false, at_m: 80.0),
    (id: "park", name: "Park", road: "top_road", forward: false, at_m: 90.0),
    (id: "mill", name: "Mill Road", road: "north_road", forward: false, at_m: 70.0),
    (id: "west_end", name: "West End", road: "avenue_west", forward: false, at_m: 70.0),
    (id: "quarry", name: "Quarry", road: "southwest_link", forward: false, at_m: 120.0),
    (id: "market", name: "Market", road: "south_road", forward: false, at_m: 60.0),
  ],
)
