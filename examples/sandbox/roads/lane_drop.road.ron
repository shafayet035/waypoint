// An arterial that narrows from two lanes each way to one at the middle node.
// The wider road tapers over a MUTCD-length taper (about 110 m at 70 km/h):
// the outer eastbound lane closes into the inner one, and westbound traffic
// gains a lane.
(
  name: "lane_drop",
  drive_side: Right,
  nodes: [
    (id: "west", position: (-400.0, 0.0)),
    (id: "mid", position: (0.0, 0.0)),
    (id: "east", position: (300.0, 0.0)),
  ],
  roads: [
    (id: "wide", name: Some("Harbour Road"), from: "west", to: "mid", shape: Straight,
     lanes_forward: 2, lanes_backward: 2, speed_limit_kmh: 70.0, sidewalk_m: 2.0),
    (id: "narrow", name: Some("Harbour Road"), from: "mid", to: "east", shape: Straight,
     lanes_forward: 1, lanes_backward: 1, speed_limit_kmh: 70.0, sidewalk_m: 2.0),
  ],
)
