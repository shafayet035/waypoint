// A village: a ring road around a crossroads, one lane each way at 50 km/h.
// The main road (west–east) has priority at the crossroads, so traffic from
// the north and south gives way; the east T-junction has traffic lights; the
// other T-junctions take turns. The High Street and the lanes have sidewalks
// with zebra crossings at the junctions.
(
  name: "village",
  drive_side: Right,
  nodes: [
    (id: "nw", position: (-200.0, 150.0)),
    (id: "n", position: (0.0, 150.0)),
    (id: "ne", position: (200.0, 150.0)),
    (id: "e", position: (200.0, 0.0), control: Signals((green_s: 15.0))),
    (id: "se", position: (200.0, -150.0)),
    (id: "s", position: (0.0, -150.0)),
    (id: "sw", position: (-200.0, -150.0)),
    (id: "w", position: (-200.0, 0.0)),
    (id: "c", position: (0.0, 0.0), control: Priority(major: ["main_west", "main_east"])),
  ],
  roads: [
    (id: "ring_n1", name: Some("Ring Road"), from: "nw", to: "n", shape: Straight),
    (id: "ring_n2", name: Some("Ring Road"), from: "n", to: "ne", shape: Straight),
    (id: "ring_e1", name: Some("Ring Road"), from: "ne", to: "e", shape: Straight),
    (id: "ring_e2", name: Some("Ring Road"), from: "e", to: "se", shape: Straight),
    (id: "ring_s1", name: Some("Ring Road"), from: "se", to: "s", shape: Straight),
    (id: "ring_s2", name: Some("Ring Road"), from: "s", to: "sw", shape: Straight),
    (id: "ring_w1", name: Some("Ring Road"), from: "sw", to: "w", shape: Straight),
    (id: "ring_w2", name: Some("Ring Road"), from: "w", to: "nw", shape: Straight),
    (id: "main_west", name: Some("High Street"), from: "w", to: "c", shape: Straight, sidewalk_m: 2.0),
    (id: "main_east", name: Some("High Street"), from: "c", to: "e", shape: Straight, sidewalk_m: 2.0),
    (id: "church_lane", name: Some("Church Lane"), from: "c", to: "n", shape: Straight, sidewalk_m: 2.0),
    (id: "mill_lane", name: Some("Mill Lane"), from: "s", to: "c", shape: Straight, sidewalk_m: 2.0),
  ],
)
