// Full throttle from rest, then an emergency stop at 9 s (about 105 km/h).
// With tyre friction 1.0 the physics limit is about 40 m from 100 km/h, 44 m from 105.
(
  scene: "scenes/flat.scene.ron",
  seed: 7,
  player: (
    vehicle: "hatchback",
    spawn: "start",
    driver: Script([
      (at_s: 0.0, throttle: 1.0),
      (at_s: 9.0, brake: 1.0),
    ]),
  ),
  duration_s: 16.0,
  assert: [
    ReachSpeed(kmh: 100.0, within_s: 11.0),
    BrakingDistance(max_m: 46.5),
    StoppedBy(s: 14.0),
    NoNaN,
    Deterministic,
  ],
)
