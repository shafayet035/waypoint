// Buildings are solid: a car accelerates flat out into a warehouse wall at
// x = 60 m at about 75 km/h. It stops against the wall (its front, 1.7 m
// ahead of its centre, at the wall), never passing through, and is dented.
(
  scene: "scenes/crash_wall.scene.ron",
  seed: 1,
  player: (
    vehicle: "hatchback",
    spawn: "run_up",
    driver: Script([(at_s: 0.0, throttle: 1.0), (at_s: 9.0, throttle: 0.0, brake: 1.0)]),
  ),
  duration_s: 12.0,
  assert: [
    ExpectEvent("Collision"),
    FinalPositionWithin(min: (56.0, -3.0), max: (58.5, 3.0)),
    NoNaN,
    Deterministic,
  ],
)
