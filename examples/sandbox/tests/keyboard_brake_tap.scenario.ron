// Driver aids: a 0.2 s tap on the brake key at 60 km/h slows the car gently
// instead of an emergency stop (holding the key still reaches full braking).
(
  scene: "scenes/flat.scene.ron",
  seed: 1,
  player: (
    vehicle: "hatchback",
    spawn: "start",
    initial_kmh: 60.0,
    driver: Keyboard([
      (at_s: 0.0),
      (at_s: 1.0, brake: 1.0),
      (at_s: 1.2),
    ]),
  ),
  duration_s: 4.0,
  assert: [
    MaxDecelG(0.4),
    NoNaN,
  ],
)
