// The harbour town: brick warehouses facing the water along Quay Road (the
// quay side stays open), and narrow, brightly painted houses climbing Market
// Street, Hill Road and Cliff Road.
(
  name: "harbour",
  styles: {
    "warehouse": (walls: [(140, 72, 58), (118, 64, 54), (152, 96, 70)], roof: (70, 70, 74),
                  storey_m: 4.2, bay_m: 4.5, window: 0.3, lit: 0.15),
    "harbour_house": (walls: [(232, 92, 80), (246, 196, 72), (84, 160, 200), (120, 190, 140),
                              (240, 236, 224), (226, 140, 170)],
                      roof: (70, 66, 80), storey_m: 2.9, bay_m: 2.6, window: 0.4, lit: 0.55, shops: true),
  },
  streets: [
